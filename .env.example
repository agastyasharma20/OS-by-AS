# Development defaults. Copy to .env (make dev does this). Never use these values in production:
# the API refuses to start with ENV=production and any of them (apps/api/app/core/config.py).
ENV=development

# Postgres superuser: bootstrap only (creates roles), never used by the app.
POSTGRES_USER=osbyas
POSTGRES_PASSWORD=osbyas
POSTGRES_DB=osbyas
MIGRATOR_DB_PASSWORD=osbyas-migrator-dev
APP_DB_PASSWORD=osbyas-app-dev
KEYCLOAK_DB_PASSWORD=osbyas-dev

REDIS_PASSWORD=osbyas-dev
S3_ACCESS_KEY=osbyas-dev
S3_SECRET_KEY=osbyas-dev-secret
S3_BUCKET=osbyas-private
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=osbyas-dev

# Used by the API when run on the host (make dev-api / make test)
DATABASE_URL=postgresql+asyncpg://osbyas_app:osbyas-app-dev@localhost:5432/osbyas
MIGRATION_DATABASE_URL=postgresql+asyncpg://osbyas_migrator:osbyas-migrator-dev@localhost:5432/osbyas
REDIS_URL=redis://:osbyas-dev@localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
OIDC_ISSUER_URL=http://localhost:8080/realms/osbyas
