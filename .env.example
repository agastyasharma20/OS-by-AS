# Development defaults. Copy to .env (make dev does this). Never use these values in production.
POSTGRES_USER=osbyas
POSTGRES_PASSWORD=osbyas
POSTGRES_DB=osbyas
S3_ACCESS_KEY=osbyas-dev
S3_SECRET_KEY=osbyas-dev-secret
S3_BUCKET=osbyas-private
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=dev-only-change-me

# Used by the API when run on the host (make dev-api / make test)
DATABASE_URL=postgresql+asyncpg://osbyas:osbyas@localhost:5432/osbyas
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
OIDC_ISSUER_URL=http://localhost:8080/realms/osbyas
